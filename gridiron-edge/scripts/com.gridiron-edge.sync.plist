<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gridiron-edge.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/WITH/YOUR/PATH/gridiron-edge/.venv/bin/gridiron</string>
    <string>sync</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>16</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/gridiron-edge-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gridiron-edge-sync.err</string>
  <key>WorkingDirectory</key>
  <string>/REPLACE/WITH/YOUR/PATH/gridiron-edge</string>
</dict>
</plist>
