# OddsPapi (primary odds source — includes Hard Rock Bet)
ODDSPAPI_API_KEY=your-key-here

# Optional fallback: The Odds API (500 free credits/month)
# https://the-odds-api.com — bookmaker key: hardrockbet
THE_ODDS_API_KEY=

# Betting defaults
STAKE_USD=5.00
MIN_EDGE_PCT=2.0

# API budget (free tier ~250 requests/month — stay conservative)
DAILY_API_BUDGET=6
CACHE_TTL_HOURS=6

# Dashboard (0.0.0.0 = reachable from other devices on your Wi‑Fi)
HOST=0.0.0.0
PORT=8787

# Data directory (Mac mini local storage)
DATA_DIR=~/.gridiron-edge
